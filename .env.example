# ===== PLATI.MARKET =====
PLATI_SELLER_ID=your_seller_id
PLATI_SECRET_KEY=your_secret_key

# Dùng 1 Goods ID duy nhất cho tất cả variant (7 ngày / 1 tháng / 6 tháng)
# Lấy từ URL: plati.market/itm/capcut-pro-.../5059273  → 5059273
PLATI_GOODS_ID=5059273

# Backup: ngưỡng giá để phân biệt variant (chỉ dùng nếu API không trả về tên)
# Cập nhật khi bạn thay đổi giá trên Plati
PRICE_THRESHOLD_7D=2      # Giá <= $2  → CapCut Pro 7 Ngày
PRICE_THRESHOLD_1M=10     # Giá <= $10 → CapCut Pro 1 Tháng
                          # Giá > $10  → CapCut Pro 6 Tháng

# ===== GGSEL.NET =====
GGSEL_SELLER_ID=your_ggsel_seller_id
GGSEL_API_KEY=your_ggsel_api_key
# Lấy từ seller.ggsel.com → Settings → API

# ===== GOOGLE SHEETS =====
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
